{
  "name": "ocnv",
  "private": true,
  "scripts": {
    "be": "pnpm --filter @ocnv/be",
    "fe": "pnpm --filter @ocnv/fe",
    "dev": "concurrently --names \"be,fe\" --prefix-colors \"blue,green\" \"pnpm --filter @ocnv/be dev\" \"pnpm --filter @ocnv/fe dev\"",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}